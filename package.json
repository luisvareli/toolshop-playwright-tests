{
  "name": "toolshop-playwright-tests",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end and API tests for the Practice Software Testing Toolshop demo, written with Playwright and TypeScript.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
